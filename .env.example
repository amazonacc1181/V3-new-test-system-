# Copy to .env in your hosting environment; do not commit real secrets.
PORT=3000
DB_PATH=./data/proctorguard.sqlite
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "require('bcryptjs').hash('a-long-unique-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Comma-separated exact frontend origins, e.g. https://amazonacc1181.github.io
CORS_ORIGINS=https://amazonacc1181.github.io,http://localhost:8000
