# Copy to .env in your hosting environment; do not commit real secrets.
PORT=3000
DB_PATH=./data/proctorguard.sqlite
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# Use a unique password of at least 12 characters; it is hashed in memory at startup.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional alternative: set ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.

# Optional durable free-prototype storage: encrypted snapshots in a SEPARATE private GitHub repository.
# Create a fine-grained token with Contents: Read and write on that private data repository only.
# Generate a 32-byte key with: openssl rand -hex 32
GITHUB_STORAGE_OWNER=
GITHUB_STORAGE_REPO=
GITHUB_STORAGE_PATH=proctorguard.sqlite.enc.json
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_ENCRYPTION_KEY=
